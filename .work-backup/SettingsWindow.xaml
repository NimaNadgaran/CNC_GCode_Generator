<Window x:Class="CNCGCodeGenerator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CNC Settings"
        Height="580"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- TITLE -->

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="CNC Settings"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,25"/>


        <!-- SETTINGS -->

        <Grid Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- FEED -->

            <Grid Grid.Row="0" Margin="0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FeedLabel"
                           Text="Feed Rate (mm/min):"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="FeedInput"
                         Grid.Column="1"
                         Padding="7"/>

            </Grid>


            <!-- SPINDLE -->

            <Grid Grid.Row="1" Margin="0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SpindleLabel"
                           Text="Spindle RPM:"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="SpindleInput"
                         Grid.Column="1"
                         Padding="7"/>

            </Grid>


            <!-- SAFE Z -->

            <Grid Grid.Row="2" Margin="0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SafeZLabel"
                           Text="Safe Z (mm):"
                           VerticalAlignment="Center"/>

                <TextBox x:Name="SafeZInput"
                         Grid.Column="1"
                         Padding="7"/>

            </Grid>


            <!-- X EXTRA -->

            <Grid Grid.Row="3" Margin="0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="XExtraLabel"
                           Text="X Extra Each Side (mm):"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBox x:Name="XExtraInput"
                         Grid.Column="1"
                         Padding="7"/>

            </Grid>


            <!-- Y EXTRA -->

            <Grid Grid.Row="4" Margin="0,8">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="YExtraLabel"
                           Text="Y Extra Each Side (mm):"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>

                <TextBox x:Name="YExtraInput"
                         Grid.Column="1"
                         Padding="7"/>

            </Grid>


            <!-- LANGUAGE -->

            <Grid Grid.Row="5" Margin="0,15,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="LanguageLabel"
                           Text="Language:"
                           VerticalAlignment="Center"/>

                <ComboBox x:Name="LanguageComboBox"
                          Grid.Column="1"
                          Height="32"
                          SelectionChanged="LanguageComboBox_SelectionChanged">

                    <ComboBoxItem Content="English"/>
                    <ComboBoxItem Content="فارسی"/>

                </ComboBox>

            </Grid>

        </Grid>


        <!-- BUTTONS -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="100"
                    Height="40"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

            <Button x:Name="SaveButton"
                    Content="Save Settings"
                    Width="130"
                    Height="40"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>