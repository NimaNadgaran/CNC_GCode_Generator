<Window x:Class="CNCGCodeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CNC G-Code Generator"
        Height="650"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <!-- =========================
             ROW DEFINITIONS
             ========================= -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- =========================
             HEADER
             ========================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <TextBlock Text="CNC G-Code Generator"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>


            <Button x:Name="SettingsButton"
                    Content="⚙ Settings"
                    Width="110"
                    Height="35"
                    HorizontalAlignment="Right"
                    Click="SettingsButton_Click"/>

        </Grid>


        <!-- =========================
             MAIN CONTENT
             ========================= -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="390"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- =========================
                 INPUTS
                 ========================= -->

            <GroupBox Grid.Column="0"
                      x:Name="DimensionsGroup"
                      Header="Dimensions"
                      Padding="15">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>


                    <!-- =========================
                         X
                         ========================= -->

                    <TextBlock x:Name="XLabel"
                               Text="X table stroke travel (mm)"
                               TextWrapping="Wrap"
                               FontSize="16"
                               Margin="0,10,0,18"/>


                    <TextBox x:Name="XInput"
                             Text=""
                             Width="280"
                             Height="40"
                             HorizontalAlignment="Left"
                             FontSize="16"
                             Padding="8"/>


                    <!-- =========================
                         Y
                         ========================= -->

                    <TextBlock x:Name="YLabel"
                               Text="Y downfeed per roughing sweep (mm)"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Margin="0,15,0,10"/>


                    <TextBox x:Name="YInput"
                             Text=""
                             Width="280"
                             Height="40"
                             HorizontalAlignment="Left"
                             FontSize="16"
                             Padding="8"/>


                    <!-- =========================
                         Z
                         ========================= -->

                    <TextBlock x:Name="ZLabel"
                               Text="Z cross-travel coverage (mm)"
                               TextWrapping="Wrap"
                               FontSize="15"
                               Margin="0,15,0,5"/>


                    <TextBox x:Name="ZInput"
                             Text=""
                             Width="280"
                             Height="40"
                             HorizontalAlignment="Left"
                             FontSize="16"
                             Padding="8"/>


                    <!-- =========================
                         GENERATE
                         ========================= -->

                    <Button x:Name="GenerateButton"
                            Content="Generate G-Code"
                            Width="280"
                            HorizontalAlignment="Left"
                            Height="40"
                            FontSize="16"
                            Margin="0,30,0,10"
                            Click="GenerateButton_Click"/>


                    <!-- =========================
                         SAVE
                         ========================= -->

                    <Button x:Name="SaveButton"
                            Content="Save G-Code"
                            Width="280"
                            HorizontalAlignment="Left"
                            Height="40"
                            FontSize="14"
                            Click="SaveButton_Click"/>

                    <CheckBox x:Name="SafetyCheck"
                              IsChecked="False"
                              Margin="0,15,0,0"
                              Checked="SafetyCheck_Changed"
                              Unchecked="SafetyCheck_Changed">
                        <TextBlock Text="I verified the start position, travel direction and clearances on the machine."
                                   TextWrapping="Wrap"
                                   MaxWidth="270"/>
                    </CheckBox>


                    <!-- =========================
                         CLEAR
                         ========================= -->

                    <Button x:Name="ClearButton"
                            Content="Clear"
                            Width="280"
                            HorizontalAlignment="Left"
                            Height="40"
                            FontSize="14"
                            Margin="0,10,0,0"
                            Click="ClearButton_Click"/>

                </StackPanel>
                </ScrollViewer>

            </GroupBox>


            <!-- =========================
                 G-CODE OUTPUT
                 ========================= -->

            <GroupBox Grid.Column="2"
                      x:Name="GCodeGroup"
                      Header="Generated G-Code"
                      Padding="10">

                <TextBox x:Name="GCodeOutput"
                         FontFamily="Consolas"
                         FontSize="14"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         IsReadOnly="True"/>

            </GroupBox>

        </Grid>


        <!-- =========================
             STATUS
             ========================= -->

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Text="Operator review required"
                   TextWrapping="Wrap"
                   FontSize="14"
                   Margin="0,15,0,0"/>

    </Grid>

</Window>
