<Window x:Class="CNCGCodeGenerator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operation and machine settings" Height="760" Width="1150" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Load machine profile" Click="LoadProfile_Click" Padding="10" Margin="4"/>
            <Button Content="Save profile for next start" Click="SaveProfile_Click" Padding="10" Margin="4"/>
            <Button Content="Cancel" IsCancel="True" Padding="15,10" Margin="4"/>
            <Button Content="Apply settings" Click="Apply_Click" Padding="15,10" Margin="4"/>
        </StackPanel>
        <TabControl>
            <TabItem Header="Operation setup">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OperationPanel" Margin="12"/></ScrollViewer>
            </TabItem>
            <TabItem Header="Machine profile and evidence">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Danobat RTM-2500 / serial 30106A / Fagor 8055M" FontWeight="Bold"/>
                        <TextBlock Text="Blank values remain unknown. Approval is specific to each operator-entered rule. Record evidence and YYYY-MM-DD date. Limits and clearance envelope are machine coordinates; machine = work + offset. Clearance bounds must describe the reviewed fixture/wheel setup. No assumed rule can enable export." TextWrapping="Wrap" Margin="0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Profile version: " VerticalAlignment="Center"/>
                            <TextBox x:Name="ProfileVersionInput" Width="180" Padding="5"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule" Binding="{Binding Name}" IsReadOnly="True" Width="210"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" IsReadOnly="True" Width="100"/>
                            <DataGridComboBoxColumn x:Name="StatusColumn" Header="Provenance" SelectedItemBinding="{Binding Status}" Width="175"/>
                            <DataGridCheckBoxColumn Header="Operator approved" Binding="{Binding OperatorApproved}" Width="80"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                            <DataGridTextColumn Header="Date confirmed" Binding="{Binding DateConfirmed, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
